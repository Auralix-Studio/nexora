# Copia este archivo a ".env" (que Git ignora) antes de usar docker compose:  cp .env.example .env
# La clave debe cumplir la política de SQL Server: mínimo 8 caracteres y 3 de 4 tipos
# (mayúsculas, minúsculas, dígitos, símbolos). Este valor es solo de ejemplo para pruebas locales.
MSSQL_SA_PASSWORD=Nexora-Local-2026

# Opcionales
# SQL_PUERTO=14330        # puerto local (127.0.0.1) para conectar con SSMS o sqlcmd al SQL Server del compose
# OMITIR_PRUEBAS=false    # true omite las pruebas JUnit al construir la imagen
