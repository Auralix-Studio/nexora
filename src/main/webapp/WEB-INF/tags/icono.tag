<%@ tag description="Ícono SVG de trazo (24x24)" pageEncoding="UTF-8" body-content="empty" %>
<%@ attribute name="nombre" required="true" %>
<%@ attribute name="tam" required="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<svg class="icono" width="${empty tam ? 20 : tam}" height="${empty tam ? 20 : tam}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><c:choose><c:when test="${nombre eq 'inicio'}"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></c:when><c:when test="${nombre eq 'caja'}"><path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="M3 8l9 5 9-5M12 13v8"/></c:when><c:when test="${nombre eq 'mas'}"><path d="M12 5v14M5 12h14"/></c:when><c:when test="${nombre eq 'registrar'}"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M12 8v8M8 12h8"/></c:when><c:when test="${nombre eq 'lista'}"><path d="M9 6h12M9 12h12M9 18h12M4 6h.01M4 12h.01M4 18h.01"/></c:when><c:when test="${nombre eq 'buscar'}"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></c:when><c:when test="${nombre eq 'editar'}"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></c:when><c:when test="${nombre eq 'eliminar'}"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6"/></c:when><c:when test="${nombre eq 'grafico'}"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></c:when><c:when test="${nombre eq 'check'}"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></c:when><c:when test="${nombre eq 'ok'}"><path d="m5 12 5 5L20 7"/></c:when><c:when test="${nombre eq 'info'}"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></c:when><c:when test="${nombre eq 'salir'}"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></c:when><c:when test="${nombre eq 'alerta'}"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></c:when><c:when test="${nombre eq 'calendario'}"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></c:when><c:when test="${nombre eq 'flecha-abajo'}"><path d="m6 9 6 6 6-6"/></c:when><c:when test="${nombre eq 'cerrar'}"><path d="M18 6 6 18M6 6l12 12"/></c:when><c:when test="${nombre eq 'monedas'}"><circle cx="9" cy="9" r="6"/><path d="M15.1 9.6A6 6 0 1 1 9.6 15.1M9 7v4M7 9h4"/></c:when><c:when test="${nombre eq 'capas'}"><path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/></c:when><c:when test="${nombre eq 'candado'}"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></c:when><c:when test="${nombre eq 'flecha'}"><path d="M5 12h14M13 6l6 6-6 6"/></c:when><c:when test="${nombre eq 'filtro'}"><path d="M3 5h18l-7 8v6l-4 2v-8z"/></c:when><c:when test="${nombre eq 'codigo'}"><path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 4l-4 16"/></c:when><c:when test="${nombre eq 'menu'}"><path d="M4 6h16M4 12h16M4 18h16"/></c:when><c:when test="${nombre eq 'tarjeta'}"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/></c:when><c:when test="${nombre eq 'comprobante'}"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6"/></c:when><c:when test="${nombre eq 'imprimir'}"><path d="M7 9V3h10v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/></c:when><c:when test="${nombre eq 'escudo'}"><path d="M12 3 4 6v6c0 4.5 3.4 8 8 9 4.6-1 8-4.5 8-9V6z"/><path d="m9 12 2 2 4-4"/></c:when><c:when test="${nombre eq 'celular'}"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></c:when><c:when test="${nombre eq 'panel'}"><rect x="3" y="3" width="8" height="9" rx="1.5"/><rect x="13" y="3" width="8" height="5" rx="1.5"/><rect x="13" y="10" width="8" height="11" rx="1.5"/><rect x="3" y="14" width="8" height="7" rx="1.5"/></c:when><c:when test="${nombre eq 'usuarios'}"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.2a6.5 6.5 0 0 1 3.5 5.8"/></c:when><c:when test="${nombre eq 'etiqueta'}"><path d="M3 3h8.2a2 2 0 0 1 1.4.6l8.2 8.2a2 2 0 0 1 0 2.8l-6.2 6.2a2 2 0 0 1-2.8 0L3.6 12.6A2 2 0 0 1 3 11.2z"/><path d="M7.5 7.5h.01"/></c:when><c:when test="${nombre e