<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
   version="6.0">

    <display-name>Sistema Web de Gestión de Productos</display-name>

    <!-- Los servlets y el listener se registran con anotaciones (@WebServlet, @WebListener).
         Los filtros se declaran aquí porque el orden importa: primero las cabeceras de seguridad (y la
         conversión de errores de datos en 503), después el control de sesión y CSRF. -->
    <filter>
        <filter-name>CabecerasSeguridad</filter-name>
        <filter-class>pe.edu.sistema.controller.CabecerasSeguridadFilter</filter-class>
    </filter>
    <filter>
        <filter-name>Sesion</filter-name>
        <filter-class>pe.edu.sistema.controller.SesionFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CabecerasSeguridad</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>Sesion</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
        </jsp-property-group>
    </jsp-config>

    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>503</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
</web-app>
