# Compilación de Maven
target/

# IDE
nbproject/private/
.idea/
*.iml
.vscode/

# Configuración local de Claude Code (los agentes y skills del proyecto sí se versionan)
.claude/settings.local.json

# Registros y temporales
*.log
*.tmp
~$*

# Secretos: nunca se versionan (ver docs/DESPLIEGUE.md)
.env
.env.*
*.publishsettings
infra/*.parameters.local.json

# Despliegue en Azure (ver docs/DESPLIEGUE.md): claves generadas y temporales de los scripts de infra/
!.env.example
infra/.secretos.local
infra/.tmp-*
infra/main.parameters.local.json
